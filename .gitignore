# Desktop shell build artifacts
apps/desktop/dist/
apps/desktop/.release/
apps/desktop/web/
.desktop-release/
apps/desktop/dist-electron/
# The optional ComfyUI installer payload: machine-local program trees (GBs)
# stay out of git; only the directory's README documents the contract.
apps/desktop/resources/comfyui-dist/*
!apps/desktop/resources/comfyui-dist/README.md
native/system/test/bin/

# Local Mimosa security-scan hook state (rewritten per commit; never a review artifact).
.mimosa/

# Emitted compiler output beside sources: a build run without its project config writes
# next to the .ts files instead of lib/types. Only shapes no authored file uses are
# ignored — a declaration file at a src/ root is authored (css-modules.d.ts) and stays
# visible, so a misbuild that emits one still shows up in git status.
packages/*/*/src/*.js
packages/*/*/src/*.js.map
packages/*/*/src/*.d.ts.map

# Generated company-signed CUA release record.
/packages/experimental/cua-macos/cua-helper.json

# Emitted declarations beside sources (same misbuild shape as the *.js rule
# above): a declaration under src/ but outside its root is compiler output,
# never authored — the authored ones live at the src/ root and stay visible.
packages/*/*/src/**/*.d.ts
!packages/*/*/src/*.d.ts
