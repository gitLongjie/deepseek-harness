{
  "name": "@xmanrui/dsh-business-entry",
  "version": "1.0.0",
  "description": "Business-entry sidebar section plugin for DeepSeek Harness: the deployment's task entries as one collapsible group below the workspace region.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "src",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "npm run build"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
